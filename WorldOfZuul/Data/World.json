        {
          "id": "City",
          "name": "City",
          "description": "Italy is in turmoil.\nA hidden system of corruption so vast it touches every corner of politics, business, and finance is beginning to crack.\nJournalists call it Tangentopoli, 'Bribesville.' To the public, it's a scandal. To those inside, it's simply the way things are done.\nYou are an investigator, newly assigned to the Mani Pulite task force.\nYour mission: follow the money, uncover the truth, and bring to light the network of bribes, offshore accounts, and secret dealings that bind together businessmen, politicians, and even religious institutions.\nBut you are not welcome here. Every office, every hidden vault, every careless note left on a desk could hold the evidence you need—or the trap that ends your investigation.\nEach room is a fragment of a larger conspiracy. Piece them together, and you may unravel one of the greatest corruption scandals in Italian history.",
          "exits": [
            { "id": "to_eni", "name": "ENI Headquarters", "targetLocationId": "eni" },
            { "id": "to_montedison", "name": "Montedison Offices", "targetLocationId": "montedison" },
            { "id": "to_bank", "name": "National Bank", "targetLocationId": "bank" },
            { "id": "to_party", "name": "Party Headquarters", "targetLocationId": "party" },
            { "id": "to_court", "name": "Courthouse", "targetLocationId": "court" }
          ],
          "npcs": [
            {
              "id": "guide",
              "name": "Senior Magistrate",
              "description": "A tired but determined judge from Mani Pulite.",
              "dialogue": [
                {
                  "id": "start",
                  "text": "Follow the money. Nothing else matters.",
                  "responses": [
                    { "text": "I understand.", "next": "end" }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },

